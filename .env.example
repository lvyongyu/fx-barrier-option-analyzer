# Template for local secrets. Copy to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored; .env.example is safe to commit.

# Turso (libSQL) credentials for the positions store.
# Get them with:
#   turso db show fx-positions --url
#   turso db tokens create fx-positions
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-token-here

# Password gate for the Streamlit UI. If set, the UI requires this password.
# Leave unset for an open local UI; SET IT on Streamlit Cloud (in the app's
# secrets) so the public URL is protected.
UI_PASSWORD=

